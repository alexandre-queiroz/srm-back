DATABASE_URL=postgresql://srm:srm@localhost:5432/srm_credit_engine
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

EXCHANGE_RATE_PRIMARY_URL=https://economia.awesomeapi.com.br/json/last/USD-BRL
EXCHANGE_RATE_SECONDARY_URL=https://open.er-api.com/v6/latest/USD

# Axiom — logs, traces e métricas via OpenTelemetry
OTEL_SERVICE_NAME=srm-credit-engine
AXIOM_TOKEN=your-axiom-api-token
AXIOM_DATASET=srm-credit-engine

# Cloudflare R2 — armazenamento de XMLs de NF-e
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=srm-nfe

# Segredo para proteger o endpoint interno de coleta de câmbio
CRON_SECRET=dev-secret
